rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COLEÇÃO: users
    // ============================================================
    match /users/{userId} {

      // LEITURA:
      // - Cliente lê APENAS seu próprio documento
      // - Admin lê QUALQUER documento
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'leetpar@gmail.com'
      );

      // CRIAÇÃO:
      // - Cliente pode criar seu próprio documento no primeiro login (via Phone Auth)
      // - Admin pode cadastrar clientes manualmente
      allow create: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == 'client' && request.resource.data.keys().hasAll(['uid', 'phoneNumber', 'name', 'role', 'points', 'createdAt'])) ||
        request.auth.token.email == 'leetpar@gmail.com'
      );

      // ATUALIZAÇÃO:
      // - Somente a Admin pode atualizar documentos (adicionar pontos, resgatar, etc.)
      allow update: if request.auth != null
        && request.auth.token.email == 'leetpar@gmail.com';

      // EXCLUSÃO:
      // - Ninguém pode excluir documentos de usuários
      allow delete: if false;

      // ============================================================
      // SUBCOLEÇÃO: history (histórico de pontos e resgates)
      // ============================================================
      match /history/{historyId} {

        // LEITURA:
        // - Cliente lê apenas seu próprio histórico
        // - Admin lê qualquer histórico
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == 'leetpar@gmail.com'
        );

        // ESCRITA:
        // - Somente a Admin pode registrar no histórico
        allow create: if request.auth != null
          && request.auth.token.email == 'leetpar@gmail.com';

        // Ninguém atualiza ou exclui histórico (auditoria imutável)
        allow update, delete: if false;
      }
    }

    // ============================================================
    // COLEÇÃO: procedures (atendimentos e lembretes de retorno)
    // ============================================================
    match /procedures/{procedureId} {

      // LEITURA:
      // - Admin lê todos os procedimentos
      // - Cliente pode ler os seus próprios procedimentos
      allow read: if request.auth != null && (
        request.auth.token.email == 'leetpar@gmail.com' ||
        resource.data.clientId == request.auth.uid
      );

      // ESCRITA (Criação, Atualização, Exclusão):
      // - Somente a Administradora gerencia procedimentos
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == 'leetpar@gmail.com';
    }

    // ============================================================
    // COLEÇÃO: expenses (despesas e custos do estúdio)
    // ============================================================
    match /expenses/{expenseId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.token.email == 'leetpar@gmail.com';
    }
  }
}
