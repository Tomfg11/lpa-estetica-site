rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // COLEÇÃO: users
    // ============================================================
    match /users/{userId} {

      // LEITURA:
      // - Cliente lê APENAS seu próprio documento
      // - Admin lê QUALQUER documento
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'leetpar@gmail.com'
      );

      // CRIAÇÃO:
      // - Cliente pode criar seu próprio documento no primeiro login (via Phone Auth)
      // - O role deve ser obrigatoriamente 'client'
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'client'
        && request.resource.data.keys().hasAll(['uid', 'phoneNumber', 'name', 'role', 'points', 'createdAt']);

      // ATUALIZAÇÃO:
      // - Somente a Admin pode atualizar documentos (adicionar pontos, resgatar, etc.)
      allow update: if request.auth != null
        && request.auth.token.email == 'leetpar@gmail.com';

      // EXCLUSÃO:
      // - Ninguém pode excluir documentos de usuários
      allow delete: if false;

      // ============================================================
      // SUBCOLEÇÃO: history (histórico de pontos e resgates)
      // ============================================================
      match /history/{historyId} {

        // LEITURA:
        // - Cliente lê apenas seu próprio histórico
        // - Admin lê qualquer histórico
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == 'leetpar@gmail.com'
        );

        // ESCRITA:
        // - Somente a Admin pode registrar no histórico
        allow create: if request.auth != null
          && request.auth.token.email == 'leetpar@gmail.com';

        // Ninguém atualiza ou exclui histórico (auditoria imutável)
        allow update, delete: if false;
      }
    }
  }
}
